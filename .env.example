# Passwords are not set here. docker-compose.yml reads them as Docker secrets
# from ./secrets/*.txt; create them with scripts/init-secrets.sh (Linux/macOS)
# or scripts/init-secrets.ps1 (Windows):
#   secrets/postgres_password.txt  database superuser (db, migrate, backup)
#   secrets/app_db_password.txt    APP_DB_USER role (api, notification-service)
#   secrets/admin_password.txt     initial admin user (login: admin)
#   secrets/session_secret.txt     API session signing key
#   secrets/email_password.txt     SMTP password (empty if email is not used)
# Outside Compose (local dev, CI) every service also accepts the plain
# variables instead: POSTGRES_PASSWORD, APP_DB_PASSWORD, ADMIN_PASSWORD,
# SESSION_SECRET and EMAIL_PASSWORD, or the matching *_FILE path. Setting both
# forms of the same variable is an error.

# PostgreSQL environments
POSTGRES_USER=pm
POSTGRES_DB=pm_db
TZ=Europe/Zagreb # Timezone

# Non-superuser role the api and notification-service connect as (created by db/migrate.sh)
APP_DB_USER=pm_app

# Daily pg_dump time (HH:MM in TZ), written to ./db/backup
BACKUP_TIME=00:00
# Days of dumps to keep in ./db/backup
BACKUP_RETENTION_DAYS=30

# Admin user: created by db/seed-admin.sh if missing (login: admin).
# Set ADMIN_PASSWORD_FORCE_RESET=true to overwrite an existing admin's password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_FORCE_RESET=false

# Backend environments (FE_URL is required in production)
NODE_ENV=production
FE_URL=http://localhost:3000

# SMTP user. Host, port, TLS, sender address and the enable switch are
# managed in Settings > System Settings and stored in the database.
EMAIL_USER=some.email@provider.com
LOG_LEVEL=info

# Set to true to log notification-service counters every 30 seconds
METRICS_ENABLED=false
